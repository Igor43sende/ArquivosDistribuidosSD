<?xml version="1.0" encoding="UTF-8"?>
<config>

    <!-- Protocolo base TCP -->
    <TCP bind_addr="192.168.15.4" bind_port="7801"/>

    <!-- Descoberta estática sem parâmetros adicionais inválidos -->
    <TCPPING initial_hosts="192.168.15.4[7801],192.168.15.10[7801]" port_range="2"/>

    <MERGE3/>
    <FD_SOCK/>
    <FD_ALL/>
    <VERIFY_SUSPECT/>

    <pbcast.NAKACK2/>
    <UNICAST3/>
    <pbcast.STABLE/>

    <pbcast.GMS print_local_addr="true"/>
    <pbcast.STATE_TRANSFER/>

</config>
