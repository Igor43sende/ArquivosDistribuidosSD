<?xml version="1.0" encoding="UTF-8"?>
<config>

    <!-- Protocolo base TCP -->
    <TCP bind_addr="127.0.0.1" bind_port="7800"/>

    <!-- Descoberta estática sem parâmetros adicionais inválidos -->
    <TCPPING initial_hosts="127.0.0.1[7800],127.0.0.1[7801]" port_range="2"/>

    <MERGE3/>
    <FD_SOCK/>
    <FD_ALL/>
    <VERIFY_SUSPECT/>

    <pbcast.NAKACK2/>
    <UNICAST3/>
    <pbcast.STABLE/>

    <pbcast.GMS print_local_addr="true"/>
    <pbcast.STATE_TRANSFER/>

</config>
