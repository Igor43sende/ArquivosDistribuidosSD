<?xml version="1.0" encoding="UTF-8"?>
<config>

    <!-- Canal TCP fixo para o cluster de CONTROLE -->
    <TCP
            bind_addr="192.168.15.4"
            bind_port="7811"
            recv_buf_size="20M"
            send_buf_size="20M"
            sock_conn_timeout="300"
    />

    <!-- Descoberta estática: obrigatória para clusters sem multicast -->
    <TCPPING
            initial_hosts="192.168.15.4[7811],192.168.15.10[7811]"
            port_range="5"
    />

    <MERGE3/>
    <FD_SOCK/>
    <FD_ALL timeout="3000" interval="1000"/>
    <VERIFY_SUSPECT timeout="1500"/>

    <!-- Ordenação total para replicação consistente -->
    <SEQUENCER/>

    <pbcast.NAKACK2 use_mcast_xmit="false"/>
    <UNICAST3/>
    <pbcast.STABLE desired_avg_gossip="2000"/>

    <pbcast.GMS print_local_addr="true" join_timeout="3000"/>

    <pbcast.STATE_TRANSFER/>

</config>
