<config>
    <TCP
            bind_addr="127.0.0.1"
            bind_port="7800"
            recv_buf_size="20M"
            send_buf_size="640K"
            max_bundle_size="64K"
            sock_conn_timeout="300"
    />

    <TCPPING
            initial_hosts="127.0.0.1[7800]"
            port_range="5"
    />

    <MERGE3
            max_interval="30000"
            min_interval="10000"
    />

    <FD_SOCK/>

    <FD_ALL
            timeout="15000"
            interval="3000"
    />

    <VERIFY_SUSPECT
            timeout="1500"
    />

    <BARRIER/>

    <pbcast.NAKACK2
            use_mcast_xmit="false"
            discard_delivered_msgs="true"
    />

    <UNICAST3/>

    <pbcast.STABLE
            desired_avg_gossip="20000"
            max_bytes="4M"
    />

    <pbcast.GMS
            print_local_addr="true"
            join_timeout="2000"
            view_bundling="true"
    />

    <UFC
            max_credits="2M"
            min_threshold="0.4"
    />

    <MFC
            max_credits="2M"
            min_threshold="0.4"
    />

    <FRAG2 frag_size="60K"/>
</config>
